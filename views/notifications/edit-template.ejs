<%- include('../layout/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Edit Template</h1>
  <a href="/notifications/templates" class="btn btn-outline-secondary">Back</a>
</div>

<form class="panel" method="post" action="/notifications/templates/<%= template.id %>">
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input name="name" class="form-control" value="<%= template.name %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Type</label>
    <select name="type" class="form-select">
      <% ['reminder','thank_you','general','festival','subscription_confirmation'].forEach(type => { %>
        <option value="<%= type %>" <%= template.type === type ? 'selected' : '' %>><%= type.replace('_', ' ') %></option>
      <% }) %>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">Message</label>
    <textarea name="message" class="form-control" rows="8" required><%= template.message %></textarea>
    <div class="form-text">Placeholders: {{name}}, {{mobile}}, {{donation_amount}}, {{donation_frequency}}, {{next_reminder_date}}</div>
  </div>
  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" name="is_active" value="1" <%= template.is_active ? 'checked' : '' %>>
    <label class="form-check-label">Active</label>
  </div>
  <div class="form-check mb-4">
    <input class="form-check-input" type="checkbox" name="is_default_cron" value="1" <%= template.is_default_cron ? 'checked' : '' %>>
    <label class="form-check-label">Default for cron reminders</label>
  </div>
  <button type="submit" class="btn btn-success">Update Template</button>
</form>
<%- include('../layout/footer') %>
