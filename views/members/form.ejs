<div class="row g-3">
  <div class="col-md-6">
    <label class="form-label">Name</label>
    <input name="name" class="form-control" value="<%= member.name || '' %>" required>
  </div>
  <div class="col-md-6">
    <label class="form-label">Mobile</label>
    <input name="mobile" class="form-control" value="<%= member.mobile || '' %>" required>
  </div>
  <div class="col-md-6">
    <label class="form-label">Email</label>
    <input type="email" name="email" class="form-control" value="<%= member.email || '' %>">
  </div>
  <div class="col-md-6">
    <label class="form-label">Donation Amount</label>
    <input type="number" step="0.01" name="donation_amount" class="form-control" value="<%= member.donation_amount || '' %>">
  </div>
  <div class="col-md-6">
    <label class="form-label">Donation Frequency</label>
    <select name="donation_frequency" class="form-select">
      <% ['monthly','quarterly','half_yearly','yearly','custom'].forEach(freq => { %>
        <option value="<%= freq %>" <%= member.donation_frequency === freq ? 'selected' : '' %>><%= freq.replace('_', ' ') %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-6">
    <label class="form-label">Next Donation Date</label>
    <input type="date" name="next_reminder_date" class="form-control" value="<%= member.next_reminder_date || '' %>">
    <div class="form-text">Select a starting date; the next date is auto calculated from frequency.</div>
  </div>
  <div class="col-md-6">
    <label class="form-label">Notify Before Donation Date</label>
    <input type="number" min="0" step="1" name="reminder_days_before" class="form-control" value="<%= member.reminder_days_before ?? 3 %>">
    <div class="form-text">Default is 3 days before.</div>
  </div>
  <div class="col-12">
    <label class="form-label">Address</label>
    <textarea name="address" class="form-control" rows="2"><%= member.address || '' %></textarea>
  </div>
  <div class="col-12">
    <label class="form-label">Notes</label>
    <textarea name="notes" class="form-control" rows="2"><%= member.notes || '' %></textarea>
  </div>
  <div class="col-md-6 form-check ms-2">
    <input class="form-check-input" type="checkbox" name="is_active" value="1" <%= member.is_active === false ? '' : 'checked' %>>
    <label class="form-check-label">Active member</label>
  </div>
  <div class="col-md-6 form-check">
    <input class="form-check-input" type="checkbox" name="whatsapp_subscribed" value="1" <%= member.whatsapp_subscribed === false ? '' : 'checked' %>>
    <label class="form-check-label">WhatsApp subscribed</label>
  </div>
</div>
