<%- include('../layout/header') %>
<div class="public-wrap">
  <form class="public-panel" method="post" action="/subscribe/verify-otp">
    <h1 class="h4 mb-2">Verify OTP</h1>
    <p class="text-muted">Enter the OTP sent to <strong><%= mobile %></strong>.</p>
    <div class="mb-3">
      <label class="form-label">OTP</label>
      <input name="otp" class="form-control" required maxlength="6">
    </div>
    <button class="btn btn-success w-100">Verify</button>
  </form>
</div>
<%- include('../layout/footer') %>
